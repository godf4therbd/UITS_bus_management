rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // FCM Tokens - users can only access their own token
    match /fcm_tokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Students - users can only access their own record
    match /students/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users - any authenticated user can read; only owner can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Admins - read-only for authenticated users; no client writes
    match /admins/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Moderators - read-only for authenticated users; no client writes
    match /moderators/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Drivers - read-only for authenticated users; no client writes
    match /drivers/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Super Admins - read-only for authenticated users; no client writes
    match /super_admins/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Buses - authenticated users can read; authenticated users can write
    match /buses/{busNumber} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Notifications - authenticated users can read and write
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Reports - authenticated users can read and create; no delete from client
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }
  }
}
